# 1. Ignore everything by default
*

# 2. Allow tracking of python files in the root directory only
!/*.py

# 3. Explicitly allow essential configuration files in the root
!/.gitignore

# 4. Allow the quality management system docs tree
!/docs/
!/docs/**/
!/docs/**/*.md

# 4b. Root-level docs (README.md, ARCHITECTURE.md, ...). Root only, so
#    nothing under data/ or any other output directory sneaks in.
!/*.md

# 5. Root-level shell utilities (document_tree.sh, ...). Root only, for
#    the same reason as the docs above. Without this the deny-by-default
#    rule at the top swallows them and `git add` reports nothing wrong
#    on a later edit - the file simply never gets staged again.
!/*.sh

# 6. Superseded scripts, kept for history. Already tracked via git mv;
#    this keeps them visible to `git add` if one is ever edited.
!/legacy/
!/legacy/*.py

# 7. QMS evidence and pinned constants (CR-0010): acceptance gates read
#    these, and the pre-repair manifests must be committed before a repair.
!/docs/quality/*.json
!/docs/quality/evidence/
!/docs/quality/evidence/*.tsv
!/docs/quality/evidence/*.txt

# 8. Unit tests.
!/tests/
!/tests/*.py

# 9. CR-0013 deliverable 1: round-7 reviewer A's evidence scripts for
#    CR-0007, copied verbatim (the directory itself is already allowed by
#    rule 4; only its .py files are added). Their CSV outputs stay ignored.
!/docs/quality/evidence/CR-0007-r7/*.py

# 10. CR-0021 deliverable 1: evidence scripts and the pre-registration
#     outputs MC pins (preregister_*.csv/.json, fetch_topup_result.json),
#     plus their logs and reports.
!/docs/quality/evidence/CR-0021/
!/docs/quality/evidence/CR-0021/*.py
!/docs/quality/evidence/CR-0021/*.txt
!/docs/quality/evidence/CR-0021/*.log
!/docs/quality/evidence/CR-0021/*.json
!/docs/quality/evidence/CR-0021/preregister_*.csv
!/docs/quality/evidence/CR-0021/reviewA/
!/docs/quality/evidence/CR-0021/reviewA/*.py
!/docs/quality/evidence/CR-0021/reviewA/*.txt
!/docs/quality/evidence/CR-0021/live/
!/docs/quality/evidence/CR-0021/live/*.txt
!/docs/quality/evidence/CR-0021/live/*.log
!/docs/quality/evidence/CR-0021/live/*.json
!/docs/quality/evidence/CR-0021/live/*.sha256

# 11. CR-0031: reviewer's wrong-implementation runs and the EC2 smoke log.
!/docs/quality/evidence/CR-0031/
!/docs/quality/evidence/CR-0031/*.txt
!/docs/quality/evidence/CR-0031/*.log
!/docs/quality/evidence/CR-0031/*.py
!/docs/quality/evidence/CR-0031/reviewA/
!/docs/quality/evidence/CR-0031/reviewA/*.txt
!/docs/quality/evidence/CR-0031/reviewA/*.py

# 12. Every CR's evidence directory, at any depth (text evidence only), so a
#     new CR-XXXX/ is tracked without a per-CR rule (rules 10-11 had to be
#     added after the fact; CR-0032 round-3 review B3-1 found the 1b runs
#     untracked the same way).
!/docs/quality/evidence/**/
!/docs/quality/evidence/**/*.txt
!/docs/quality/evidence/**/*.log
!/docs/quality/evidence/**/*.py
!/docs/quality/evidence/**/*.json
!/docs/quality/evidence/**/*.tsv
